#!/usr/bin/env python3
"""Run caesar from the plugin folder without installing it."""

import os
import shlex
import sys
from pathlib import Path

HERE = Path(__file__).resolve()
sys.path.insert(0, str(HERE.parent.parent))
# NEXT lines name this launcher, so the model can run them from any folder.
if "CAESAR_CMD" not in os.environ:
    os.environ["CAESAR_CMD"] = f'python "{HERE}"' if os.name == "nt" else "python3 " + shlex.quote(str(HERE))

from caesar.cli import main  # noqa: E402

sys.exit(main())
